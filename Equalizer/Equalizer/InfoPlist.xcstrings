    "NSAppleMusicUsageDescription" : {
      "comment" : "Privacy - Media Library Usage Description",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Equalizer plays a track from your Music library to compare it with what your speakers reproduce."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Equalizer 会读取您音乐资料库中的一首曲目，以便与扬声器实际播放的声音进行比较。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Equalizer uses the local network to send noise to your AirPlay speakers."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "本 App 会使用本地网络，将噪声发送到您的 AirPlay 扬声器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This app analyzes audio from the microphone to display a live frequency spectrum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "本 App 会分析麦克风的音频，以实时显示频谱。"
          }
        }
      }
    }
  },
  "version" : "1.3"
